 namespace audio {
 
+namespace {
+// XBE_AUDIO_DUMP=<file.wav>: everything sent to the speakers, 48 kHz stereo float, for checking the sound offline
+struct Dump {
+    FILE* f = nullptr;
+    uint32_t bytes = 0;
+    Dump() {
+        if (const char* path = std::getenv("XBE_AUDIO_DUMP")) {
+            // one file a process: a title that relaunches itself does not overwrite its predecessor's
+            std::string name = path;
+            size_t dot = name.rfind('.');
+            name.insert(dot == std::string::npos ? name.size() : dot, "-" + std::to_string(GetCurrentProcessId()));
+            f = std::fopen(name.c_str(), "wb");
+            if (f) Header();
+            LOGR("audio: recording the output to %s", name.c_str());
+        }
+    }
+    void Header() {
+        auto u32 = [&](uint32_t v) { std::fwrite(&v, 4, 1, f); };
+        auto u16 = [&](uint16_t v) { std::fwrite(&v, 2, 1, f); };
+        std::fseek(f, 0, SEEK_SET);
+        std::fwrite("RIFF", 1, 4, f), u32(36 + bytes), std::fwrite("WAVEfmt ", 1, 8, f), u32(16);
+        u16(3), u16(2), u32(kRate), u32(kRate * 8), u16(8), u16(32);
+        std::fwrite("data", 1, 4, f), u32(bytes);
+        std::fseek(f, 0, SEEK_END);
+    }
+    void Write(const float* b, uint32_t frames) {
+        if (!f) return;
+        std::fwrite(b, 8, frames, f);
+        bytes += frames * 8;
+        if (bytes % (kRate * 8) < frames * 8) {  // about once a second the sizes are right, the file stays readable
+            Header();
+            std::fflush(f);
+        }
+    }
+};
+}  // namespace
