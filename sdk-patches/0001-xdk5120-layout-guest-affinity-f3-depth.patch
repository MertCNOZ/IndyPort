diff --git a/runtime/gpu/ui_upscale.cpp b/runtime/gpu/ui_upscale.cpp
new file mode 100644
index 0000000..3e0632f
--- /dev/null
+++ b/runtime/gpu/ui_upscale.cpp
@@ -0,0 +1,205 @@
+#include "gpu/ui_upscale.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace gpu::ui_upscale {
+
+namespace {
+
+constexpr uint32_t kMaxSide = 2048;  // the upscaled texture's longest side
+constexpr uint32_t kMaxFactor = 4;
+
+// ---- BC1 BC2 BC3 into BGRA
+
+void Colour565(uint16_t c, uint8_t out[3]) {  // B G R
+    out[2] = uint8_t(((c >> 11) & 31) * 255 / 31);
+    out[1] = uint8_t(((c >> 5) & 63) * 255 / 63);
+    out[0] = uint8_t((c & 31) * 255 / 31);
+}
+
+// a 4x4 block's colours (BC1 with its 3-colour mode when alone) into px, 16 BGRA
+void ColourBlock(const uint8_t* b, bool bc1, uint8_t px[64]) {
+    uint16_t c0 = uint16_t(b[0] | b[1] << 8), c1 = uint16_t(b[2] | b[3] << 8);
+    uint8_t pal[4][4] = {};
+    Colour565(c0, pal[0]);
+    Colour565(c1, pal[1]);
+    for (int i = 0; i < 4; i++) pal[i][3] = 255;
+    if (c0 > c1 || !bc1) {
+        for (int k = 0; k < 3; k++) {
+            pal[2][k] = uint8_t((2 * pal[0][k] + pal[1][k]) / 3);
+            pal[3][k] = uint8_t((pal[0][k] + 2 * pal[1][k]) / 3);
+        }
+    } else {
+        for (int k = 0; k < 3; k++) pal[2][k] = uint8_t((pal[0][k] + pal[1][k]) / 2);
+        pal[3][3] = 0;
+    }
+    uint32_t bits = uint32_t(b[4] | b[5] << 8 | b[6] << 16 | uint32_t(b[7]) << 24);
+    for (int i = 0; i < 16; i++) std::memcpy(px + i * 4, pal[(bits >> (i * 2)) & 3], 4);
+}
+
+void AlphaBc3(const uint8_t* b, uint8_t px[64]) {
+    uint8_t a[8] = {b[0], b[1]};
+    if (a[0] > a[1]) {
+        for (int i = 1; i < 7; i++) a[i + 1] = uint8_t(((7 - i) * a[0] + i * a[1]) / 7);
+    } else {
+        for (int i = 1; i < 5; i++) a[i + 1] = uint8_t(((5 - i) * a[0] + i * a[1]) / 5);
+        a[6] = 0;
+        a[7] = 255;
+    }
+    uint64_t bits = 0;
+    for (int i = 0; i < 6; i++) bits |= uint64_t(b[2 + i]) << (8 * i);
+    for (int i = 0; i < 16; i++) px[i * 4 + 3] = a[(bits >> (3 * i)) & 7];
+}
+
+void AlphaBc2(const uint8_t* b, uint8_t px[64]) {
+    for (int i = 0; i < 16; i++) {
+        uint8_t nib = uint8_t((b[i / 2] >> ((i & 1) * 4)) & 15);
+        px[i * 4 + 3] = uint8_t(nib * 17);
+    }
+}
+
+bool ToBgra(const texturedumper::Image& in, std::vector<uint8_t>& out) {
+    const texturedumper::Level& l = in.levels[0];
+    uint32_t w = in.width, h = in.height;
+    out.assign(size_t(w) * h * 4, 0);
+    if (in.format == DXGI_FORMAT_B8G8R8A8_UNORM) {
+        for (uint32_t y = 0; y < h; y++) std::memcpy(&out[size_t(y) * w * 4], &l.px[size_t(y) * l.pitch], size_t(w) * 4);
+        return true;
+    }
+    bool bc1 = in.format == DXGI_FORMAT_BC1_UNORM, bc2 = in.format == DXGI_FORMAT_BC2_UNORM;
+    if (!bc1 && !bc2 && in.format != DXGI_FORMAT_BC3_UNORM) return false;
+    uint32_t block = bc1 ? 8 : 16;
+    for (uint32_t by = 0; by < (h + 3) / 4; by++)
+        for (uint32_t bx = 0; bx < (w + 3) / 4; bx++) {
+            const uint8_t* b = &l.px[size_t(by) * l.pitch + size_t(bx) * block];
+            uint8_t px[64];
+            ColourBlock(bc1 ? b : b + 8, bc1, px);
+            if (bc2) AlphaBc2(b, px);
+            if (!bc1 && !bc2) AlphaBc3(b, px);
+            for (uint32_t i = 0; i < 16; i++) {
+                uint32_t x = bx * 4 + i % 4, y = by * 4 + i / 4;
+                if (x < w && y < h) std::memcpy(&out[(size_t(y) * w + x) * 4], px + i * 4, 4);
+            }
+        }
+    return true;
+}
+
+// ---- Catmull-Rom
+
+float Weight(float t) {
+    t = std::fabs(t);
+    if (t < 1) return 1.5f * t * t * t - 2.5f * t * t + 1;
+    if (t < 2) return -0.5f * t * t * t + 2.5f * t * t - 4 * t + 2;
+    return 0;
+}
+
+// a mask: most texels fully clear or fully solid, some of each, and few in between (font glyphs, icon cut-outs; not
+// a soft glow, whose alpha fades over many texels)
+bool IsMask(const std::vector<uint8_t>& px) {
+    size_t n = px.size() / 4, clear = 0, solid = 0;
+    for (size_t i = 0; i < n; i++) {
+        uint8_t a = px[i * 4 + 3];
+        clear += a < 16;
+        solid += a > 239;
+    }
+    size_t between = n - clear - solid;
+    return clear > n / 20 && solid > n / 100 && clear + solid > n * 8 / 10 && between * 2 < solid;
+}
+
+}  // namespace
+
+bool Make(const texturedumper::Image& in, texturedumper::Image& out) {
+    if (in.levels.empty() || !in.width || !in.height) return false;
+    uint32_t side = std::max(in.width, in.height);
+    uint32_t f = std::min(kMaxFactor, kMaxSide / side);
+    if (f < 2) return false;
+    std::vector<uint8_t> src;
+    if (!ToBgra(in, src)) return false;
+    bool mask = IsMask(src);
+    uint32_t sw = in.width, sh = in.height, w = sw * f, h = sh * f;
+
+    // separable: rows into a float buffer. Colour is not premultiplied by alpha: additive effects draw colour where
+    // alpha is 0, and would lose it
+    std::vector<float> pre(size_t(sw) * sh * 4);
+    for (size_t i = 0; i < size_t(sw) * sh * 4; i++) pre[i] = src[i] / 255.0f;
+    auto taps = [](uint32_t n, uint32_t f, uint32_t o, int idx[4], float wt[4]) {
+        float s = (o + 0.5f) / f - 0.5f;
+        int base = int(std::floor(s));
+        float sum = 0;
+        for (int t = 0; t < 4; t++) {
+            idx[t] = std::clamp(base - 1 + t, 0, int(n) - 1);
+            wt[t] = Weight(s - float(base - 1 + t));
+            sum += wt[t];
+        }
+        for (int t = 0; t < 4; t++) wt[t] /= sum;
+    };
+    std::vector<float> rows(size_t(w) * sh * 4);
+    for (uint32_t x = 0; x < w; x++) {
+        int idx[4];
+        float wt[4];
+        taps(sw, f, x, idx, wt);
+        for (uint32_t y = 0; y < sh; y++)
+            for (int k = 0; k < 4; k++) {
+                float v = 0;
+                for (int t = 0; t < 4; t++) v += wt[t] * pre[(size_t(y) * sw + idx[t]) * 4 + k];
+                rows[(size_t(y) * w + x) * 4 + k] = v;
+            }
+    }
+    out = {};
+    out.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    out.width = w;
+    out.height = h;
+    out.levels.resize(1);
+    out.levels[0].pitch = w * 4;
+    out.levels[0].px.resize(size_t(w) * h * 4);
+    uint8_t* dst = out.levels[0].px.data();
+    std::vector<float> alpha(size_t(w) * h);
+    for (uint32_t y = 0; y < h; y++) {
+        int idx[4];
+        float wt[4];
+        taps(sh, f, y, idx, wt);
+        for (uint32_t x = 0; x < w; x++) {
+            float v[4] = {};
+            for (int t = 0; t < 4; t++)
+                for (int k = 0; k < 4; k++) v[k] += wt[t] * rows[(size_t(idx[t]) * w + x) * 4 + k];
+            float a = std::clamp(v[3], 0.0f, 1.0f);
+            alpha[size_t(y) * w + x] = a;
+            uint8_t* p = dst + (size_t(y) * w + x) * 4;
+            for (int k = 0; k < 3; k++) p[k] = uint8_t(std::clamp(v[k], 0.0f, 1.0f) * 255 + 0.5f);
+        }
+    }
+    // A mask's edge follows the console texels' stair steps. Blurred over about one source texel those steps become
+    // a straight slope, and tightened around half coverage the slope is a crisp, smooth outline (much as a distance
+    // field draws text). Two box passes each way are close to a Gaussian.
+    if (mask) {
+        int r = int(f * 3 / 4);
+        std::vector<float> tmp(alpha.size());
+        auto box = [&](std::vector<float>& from, std::vector<float>& to, bool across) {
+            uint32_t n = across ? w : h, lines = across ? h : w;
+            for (uint32_t line = 0; line < lines; line++) {
+                auto at = [&](int i) -> float& {
+                    int c = std::clamp(i, 0, int(n) - 1);
+                    return across ? from[size_t(line) * w + c] : from[size_t(c) * w + line];
+                };
+                float sum = 0;
+                for (int i = -r; i <= r; i++) sum += at(i);
+                for (uint32_t i = 0; i < n; i++) {
+                    (across ? to[size_t(line) * w + i] : to[size_t(i) * w + line]) = sum / float(2 * r + 1);
+                    sum += at(int(i) + r + 1) - at(int(i) - r);
+                }
+            }
+        };
+        for (int pass = 0; pass < 2; pass++) {
+            box(alpha, tmp, true);
+            box(tmp, alpha, false);
+        }
+        float tighten = float(f) / 1.2f;
+        for (float& a : alpha) a = std::clamp((a - 0.5f) * tighten + 0.5f, 0.0f, 1.0f);
+    }
+    for (size_t i = 0; i < alpha.size(); i++) dst[i * 4 + 3] = uint8_t(alpha[i] * 255 + 0.5f);
+    return true;
+}
+
+}  // namespace gpu::ui_upscale
