+#include "gpu/texturedumper.h"
+
+// Sharper 2D: the textures the game draws in screen space (its fonts, menus, HUD and button icons) are made at up to
+// 4 times their size when first drawn, so they stay smooth at high resolutions. Colour is upscaled with a
+// Catmull-Rom filter; a texture whose alpha is a mask (mostly fully clear or fully solid, as font glyphs are) also
+// gets its edges tightened, so the upscaled glyphs have crisp, smooth outlines instead of the console's blocky ones.
+// Made on the player's machine from their own copy of the game; nothing of the game is shipped.
+namespace gpu::ui_upscale {
+
+// level 0 of in (B8G8R8A8 or BC1/BC2/BC3) into out as B8G8R8A8 with mipmaps; false when the texture is left as it
+// is (too large already, or a format this does not read)
+bool Make(const texturedumper::Image& in, texturedumper::Image& out);
+
+}  // namespace gpu::ui_upscale
