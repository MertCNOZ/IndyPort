+        cap_left--;
+        uint32_t vb = g_state.streams[0].vb;
+        LOGR("origin %04d: %s prim %u count %u vs %X stream0 %08X data %08X stride %u src %08X", cap_n++, path, prim,
+             count, g_state.vs_handle, vb, vb ? R32(vb + 4) : 0, g_state.streams[0].stride, src);
+        return;
+    }
+    if (!want) return;
+    if (by_count ? (prim != 8 || count != want) : ((g_state.vs_handle & ~1u) != want || (prim != 5 && prim != 8))) return;
+    if (seen[path]++ >= 4) return;
+    LOGR("origin: %s prim %u count %u vs %X", path, prim, count, g_state.vs_handle);
+    if (kernel::Current()) kernel::LogGuestStack(kernel::CurrentContext(), 128);
